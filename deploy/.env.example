# Compose 用的环境变量模板。
# 服务器上不用手抄：scripts/server-init.sh 会生成 /opt/jianshanagent/shared/.env 并填好随机密码。
# 本机试跑时复制为 deploy/.env（不入库）再改。

# 数据库密码。会拼进连接串，只用字母和数字（如 openssl rand -hex 24）
POSTGRES_PASSWORD=change-me

# 所有数据的根目录（postgres / redis / backups / bot，加上部署插件各自的子目录）。
# 目录要事先建好并设好属主，见 scripts/server-init.sh
JIANSHANAGENT_DATA_DIR=/home/jianshanagent
# 凭据文件在宿主机上的位置；容器以 uid 10001 运行，文件要属于 10001、权限 600
JIANSHANAGENT_SECRETS_FILE=/opt/jianshanagent/shared/secrets.yaml

# 机器人健康检查端口，只绑 127.0.0.1
HEALTH_PORT=18080
# 管理后台（网页）对外的地址和端口。局域网访问就填服务器的内网地址；不填只绑 127.0.0.1
ADMIN_BIND_ADDR=127.0.0.1
ADMIN_PORT=13001

# 备份：每天几点做（服务器本地时间）、保留几天
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
# 备份的第二个存放处（可选，强烈建议填）：另一块盘上的目录，每次备份完再拷一份过去，那边留最新的 BACKUP_COPY_KEEP 份。
# 不填的话备份和数据库在同一块盘上，盘坏了两样一起没。目录要事先建好：install -d -m 700 -o 999 -g 999 <目录>
# BACKUP_COPY_DIR=/opt/jianshanagent/backups
# BACKUP_COPY_KEEP=3

# 构建镜像时用的 PyPI 镜像源（可选）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ---------- 部署插件 ----------
# 带哪些部署插件：deploy/plugins/ 下的目录名，逗号或空格隔开。一个都不带就留空，但这一行要在
# （scripts/ctl 看不到这一行会报错，免得少写一行就悄悄把日志之类的服务丢掉）。
# 本机试跑时 compose 要自己带上插件的片段：
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml -f deploy/plugins/logs/compose.yaml up -d
JIANSHANAGENT_DEPLOY_PLUGINS=logs

# logs（运行日志：Loki + Alloy + Grafana）。服务器上这几项不用手写：上线前 plugins/logs/init.sh 会把缺的补上。
# Grafana 管理员（admin）密码。只在 Grafana 第一次初始化时生效
GRAFANA_ADMIN_PASSWORD=change-me
# Grafana 对外的地址和端口（局域网访问就填服务器的内网地址）
GRAFANA_BIND_ADDR=127.0.0.1
GRAFANA_PORT=13000
